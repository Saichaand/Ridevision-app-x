rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser() {
      let data = request.resource.data;
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.email is string &&
             data.displayName is string &&
             data.safetyTier is string &&
             data.verifiedCount is int &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             (!('milesCovered' in data) || data.milesCovered is string) &&
             (!('vehicleModel' in data) || data.vehicleModel is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidPothole() {
      let data = request.resource.data;
      return data.id is string &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             (data.lat is float || data.lat is int) &&
             (data.lon is float || data.lon is int) &&
             data.address is string &&
             data.severity in ['MINOR', 'MODERATE', 'SEVERE'] &&
             data.status in ['ACTIVE', 'IN_PROGRESS', 'VERIFIED_FIXED'] &&
             (!('ticketNumber' in data) || data.ticketNumber is string) &&
             (!('city' in data) || data.city is string) &&
             (!('laneInfo' in data) || data.laneInfo is string) &&
             (!('confirmationCount' in data) || data.confirmationCount is int) &&
             (!('fixedConfirmationCount' in data) || data.fixedConfirmationCount is int) &&
             (!('notes' in data) || data.notes is string) &&
             (!('depthCm' in data) || data.depthCm is float || data.depthCm is int) &&
             (!('widthCm' in data) || data.widthCm is float || data.widthCm is int) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser();
      allow delete: if false;
    }

    // Community Pothole & Road Hazard Registry
    match /potholes/{potholeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPothole();
      // Allow report owner to edit or any authenticated rider to confirm / verify repair
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmationCount', 'fixedConfirmationCount', 'status', 'statusNote', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
